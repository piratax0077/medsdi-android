<?xml version="1.0" encoding="UTF-8"?>
<plugin xmlns="http://apache.org/cordova/ns/plugins/1.0"
        id="cordova-plugin-texto-fijo"
        version="1.0.0">

    <name>Texto fijo</name>
    <description>Ignora el tamaño de fuente del sistema Android para que el diseño de la app no se desordene.</description>
    <license>Apache 2.0</license>

    <engines>
        <engine name="cordova-android" version=">=10.0.0" />
    </engines>

    <platform name="android">
        <config-file target="res/xml/config.xml" parent="/*">
            <feature name="TextoFijo">
                <param name="android-package" value="com.medichile.textofijo.TextoFijo" />
                <param name="onload" value="true" />
            </feature>
        </config-file>

        <source-file src="src/android/TextoFijo.java" target-dir="src/com/medichile/textofijo" />
    </platform>
</plugin>
