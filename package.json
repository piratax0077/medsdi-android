{
  "name": "com.medichile.app",
  "displayName": "MED-SDI",
  "version": "1.0.1",
  "description": "Aplicación móvil de Salud Digital Integrada.",
  "main": "index.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [
    "ecosystem:cordova"
  ],
  "author": "Salud Digital Integrada",
  "license": "Apache-2.0",
  "devDependencies": {
    "cordova": "^13.0.0",
    "cordova-android": "^15.0.0",
    "cordova-browser": "^7.0.0",
    "cordova-plugin-camera": "^8.0.0",
    "cordova-plugin-device": "^3.0.0",
    "cordova-plugin-dialogs": "^2.0.2",
    "cordova-plugin-firebasex-core": "^2.0.0",
    "cordova-plugin-firebasex-messaging": "^2.0.1",
    "cordova-plugin-geolocation": "^5.0.0",
    "cordova-plugin-inappbrowser": "^6.0.0",
    "cordova-plugin-texto-fijo": "file:local-plugins/cordova-plugin-texto-fijo"
  },
  "cordova": {
    "platforms": [
      "browser",
      "android"
    ],
    "plugins": {
      "cordova-plugin-inappbrowser": {},
      "cordova-plugin-firebasex-core": {
        "ANDROID_FIREBASE_CORE_VERSION": "21.1.1",
        "ANDROID_FIREBASE_INSTALLATIONS_VERSION": "19.1.0",
        "ANDROID_GSON_VERSION": "2.14.0"
      },
      "cordova-plugin-firebasex-messaging": {
        "FIREBASE_FCM_AUTOINIT_ENABLED": "true",
        "FIREBASE_MESSAGING_IMMEDIATE_PAYLOAD_DELIVERY": "false",
        "IOS_FCM_ENABLED": "true",
        "IOS_ENABLE_CRITICAL_ALERTS_ENABLED": "false",
        "ANDROID_ICON_ACCENT": "#FFFFFF",
        "ANDROID_FIREBASE_MESSAGING_VERSION": "25.0.2"
      },
      "cordova-plugin-dialogs": {},
      "cordova-plugin-fingerprint-aio": {},
      "cordova-plugin-camera": {
        "ANDROIDX_CORE_VERSION": "1.6.+"
      },
      "cordova-plugin-geolocation": {
        "ANDROIDX_CORE_VERSION": "1.6.+",
        "GPS_REQUIRED": "true"
      },
      "cordova-plugin-device": {},
      "cordova-plugin-texto-fijo": {}
    }
  },
  "dependencies": {
    "cordova-plugin-fingerprint-aio": "6.0.1"
  }
}
